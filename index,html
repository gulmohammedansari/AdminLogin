<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard — Family Registrations</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg-deep:       #05070f;
      --bg-card:       #0d1120;
      --bg-field:      #111827;
      --border:        #1e2d4a;
      --border-focus:  #3b82f6;
      --accent-blue:   #3b82f6;
      --accent-cyan:   #06b6d4;
      --accent-purple: #8b5cf6;
      --gradient:      linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #06b6d4 100%);
      --text-primary:  #f1f5f9;
      --text-muted:    #64748b;
      --text-label:    #94a3b8;
      --success:       #10b981;
      --error:         #ef4444;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg-deep);
      color: var(--text-primary);
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      padding: 2rem 1rem 4rem;
      position: relative;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      top: -200px; left: 50%;
      transform: translateX(-50%);
      width: 900px; height: 600px;
      background: radial-gradient(ellipse at center, rgba(59,130,246,0.10) 0%, rgba(139,92,246,0.05) 50%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    .page-wrap { position: relative; z-index: 1; max-width: 1100px; margin: 0 auto; }

    /* ── Logo / header ─────────────────────────────────────────────────── */
    .logo-mark { display: flex; align-items: center; gap: 10px; margin-bottom: 2rem; justify-content: center; }
    .logo-icon {
      width: 36px; height: 36px;
      background: var(--gradient);
      border-radius: 9px;
      display: flex; align-items: center; justify-content: center;
    }
    .logo-icon svg { width: 20px; height: 20px; fill: white; }
    .logo-text {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.1rem;
      font-weight: 700;
      background: var(--gradient);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }

    /* ── Login screen ──────────────────────────────────────────────────── */
    #loginScreen { display: flex; justify-content: center; padding-top: 3rem; }
    .login-card {
      width: 100%; max-width: 400px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 2.5rem;
      box-shadow: 0 8px 40px rgba(0,0,0,0.4);
    }
    .login-card h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 0.4rem;
      text-align: center;
    }
    .login-card .sub {
      text-align: center;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 2rem;
    }

    .field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 1.1rem; }
    .field label { font-size: 0.78rem; font-weight: 500; color: var(--text-label); }
    .field input {
      background: var(--bg-field);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text-primary);
      font-family: 'Inter', sans-serif;
      font-size: 0.92rem;
      padding: 0.75rem 1rem;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
      width: 100%;
    }
    .field input:focus { border-color: var(--border-focus); box-shadow: 0 0 0 3px rgba(59,130,246,0.12); }
    .field input.error { border-color: var(--error); }

    .login-error {
      display: none;
      background: rgba(239,68,68,0.1);
      border: 1px solid rgba(239,68,68,0.3);
      color: #fca5a5;
      font-size: 0.82rem;
      padding: 0.7rem 1rem;
      border-radius: 10px;
      margin-bottom: 1.1rem;
    }
    .login-error.show { display: block; }

    .btn {
      width: 100%;
      padding: 0.85rem 1.5rem;
      background: var(--gradient);
      border: none;
      border-radius: 12px;
      color: #fff;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      transition: opacity 0.2s, transform 0.15s;
    }
    .btn:hover { opacity: 0.9; transform: translateY(-1px); }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
    .btn .spinner {
      display: none; width: 16px; height: 16px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: #fff; border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }
    .btn.loading .spinner { display: block; }
    .btn.loading .btn-text { opacity: 0.6; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── Dashboard screen ──────────────────────────────────────────────── */
    #dashboardScreen { display: none; }

    .topbar {
      display: flex; align-items: center; justify-content: space-between;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1rem 1.5rem;
      margin-bottom: 1.5rem;
    }
    .topbar .who { display: flex; align-items: center; gap: 10px; }
    .badge {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 0.3rem 0.65rem;
      border-radius: 6px;
    }
    .badge.super { background: rgba(139,92,246,0.15); color: #c4b5fd; border: 1px solid rgba(139,92,246,0.35); }
    .badge.admin { background: rgba(6,182,212,0.15); color: #67e8f9; border: 1px solid rgba(6,182,212,0.35); }
    .who-name { font-size: 0.92rem; font-weight: 600; }
    .who-scope { font-size: 0.78rem; color: var(--text-muted); }

    .btn-logout {
      background: var(--bg-field);
      border: 1px solid var(--border);
      color: var(--text-label);
      padding: 0.55rem 1.1rem;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s;
    }
    .btn-logout:hover { border-color: var(--error); color: #fca5a5; }

    .stats-row { display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .stat-card {
      flex: 1; min-width: 140px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.1rem 1.3rem;
    }
    .stat-card .num {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.6rem; font-weight: 700;
      background: var(--gradient);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .stat-card .lbl { font-size: 0.75rem; color: var(--text-muted); margin-top: 2px; }

    .table-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
    }
    .table-scroll { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    thead th {
      background: var(--bg-field);
      text-align: left;
      padding: 0.85rem 1rem;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--accent-cyan);
      white-space: nowrap;
      border-bottom: 1px solid var(--border);
    }
    tbody td {
      padding: 0.8rem 1rem;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
      color: var(--text-primary);
    }
    tbody tr:last-child td { border-bottom: none; }
    tbody tr:hover { background: rgba(59,130,246,0.04); }
    .cluster-chip {
      display: inline-block;
      padding: 0.2rem 0.6rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 600;
      background: rgba(59,130,246,0.12);
      color: #93c5fd;
      border: 1px solid rgba(59,130,246,0.3);
    }
    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    /* Toast */
    .toast {
      position: fixed; bottom: 2rem; left: 50%;
      transform: translateX(-50%) translateY(100px);
      padding: 1rem 1.5rem; border-radius: 14px;
      font-size: 0.9rem; font-weight: 500;
      display: flex; align-items: center; gap: 10px;
      z-index: 999;
      transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1);
      max-width: 400px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.4);
    }
    .toast.show { transform: translateX(-50%) translateY(0); }
    .toast.error-toast { background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.4); color: #fca5a5; }
    .toast.success-toast { background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.4); color: #6ee7b7; }

    /* ── Tabs ──────────────────────────────────────────────────────────── */
    .tab-row { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
    .tab-btn {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 0.6rem 1.2rem;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
    }
    .tab-btn.active {
      background: rgba(59,130,246,0.1);
      border-color: var(--accent-blue);
      color: var(--text-primary);
    }

    /* ── Manage Admins panel ──────────────────────────────────────────── */
    #manageAdminsView { display: none; }
    .panel-grid { display: grid; grid-template-columns: 1fr 340px; gap: 1.5rem; align-items: start; }
    .panel-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
    }
    .panel-card h2 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 1.2rem;
    }
    .role-select {
      background: var(--bg-field);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text-primary);
      font-family: 'Inter', sans-serif;
      font-size: 0.92rem;
      padding: 0.75rem 1rem;
      outline: none;
      width: 100%;
      cursor: pointer;
    }
    .role-select:focus { border-color: var(--border-focus); }
    .cluster-checks {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      margin-top: 4px;
    }
    .cluster-check-item {
      display: flex; align-items: center; gap: 8px;
      background: var(--bg-field);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.55rem 0.75rem;
      cursor: pointer;
      font-size: 0.85rem;
      transition: border-color 0.2s;
    }
    .cluster-check-item:has(input:checked) { border-color: var(--accent-blue); background: rgba(59,130,246,0.08); }
    .cluster-check-item input { accent-color: var(--accent-blue); cursor: pointer; }
    .form-hint { font-size: 0.75rem; color: var(--text-muted); margin-top: 4px; }
    .create-error {
      display: none;
      background: rgba(239,68,68,0.1);
      border: 1px solid rgba(239,68,68,0.3);
      color: #fca5a5;
      font-size: 0.8rem;
      padding: 0.65rem 0.9rem;
      border-radius: 10px;
      margin-bottom: 1rem;
    }
    .create-error.show { display: block; }
    .role-pill {
      display: inline-block;
      padding: 0.15rem 0.55rem;
      border-radius: 6px;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
    }
    .role-pill.super { background: rgba(139,92,246,0.15); color: #c4b5fd; }
    .role-pill.admin { background: rgba(6,182,212,0.15); color: #67e8f9; }

    @media (max-width: 640px) {
      .topbar { flex-direction: column; align-items: flex-start; gap: 1rem; }
      .stats-row { flex-direction: column; }
      .panel-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="page-wrap">

    <div class="logo-mark">
      <div class="logo-icon">
        <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
      </div>
      <span class="logo-text">FamilyConnect Admin</span>
    </div>

    <!-- ═══ LOGIN SCREEN ═══ -->
    <div id="loginScreen">
      <div class="login-card">
        <h1>Admin Login</h1>
        <p class="sub">Sign in with your assigned credentials</p>

        <div class="login-error" id="loginError"></div>

        <form id="loginForm" novalidate>
          <div class="field">
            <label>Username</label>
            <input type="text" id="username" autocomplete="username" />
          </div>
          <div class="field">
            <label>Password</label>
            <input type="password" id="password" autocomplete="current-password" />
          </div>
          <button type="submit" class="btn" id="loginBtn">
            <div class="spinner"></div>
            <span class="btn-text">Sign In</span>
          </button>
        </form>
      </div>
    </div>

    <!-- ═══ DASHBOARD SCREEN ═══ -->
    <div id="dashboardScreen">
      <div class="topbar">
        <div class="who">
          <span class="badge" id="roleBadge"></span>
          <div>
            <div class="who-name" id="whoName"></div>
            <div class="who-scope" id="whoScope"></div>
          </div>
        </div>
        <button class="btn-logout" id="logoutBtn">Log Out</button>
      </div>

      <div class="tab-row" id="tabRow">
        <button class="tab-btn active" id="tabRegistrations" data-view="registrations">Registrations</button>
      </div>

      <!-- ═══ REGISTRATIONS VIEW ═══ -->
      <div id="registrationsView">
        <div class="stats-row">
          <div class="stat-card">
            <div class="num" id="statTotal">0</div>
            <div class="lbl">Records Visible</div>
          </div>
          <div class="stat-card">
            <div class="num" id="statClusters">0</div>
            <div class="lbl">Clusters in View</div>
          </div>
        </div>

        <div class="table-card">
          <div class="table-scroll">
            <table id="dataTable">
              <thead id="tableHead"></thead>
              <tbody id="tableBody"></tbody>
            </table>
          </div>
          <div class="empty-state" id="emptyState" style="display:none;">No records found for your access scope.</div>
        </div>
      </div>

      <!-- ═══ MANAGE ADMINS VIEW (SuperAdmin only) ═══ -->
      <div id="manageAdminsView">
        <div class="panel-grid">

          <div class="panel-card">
            <h2>Existing Admin Accounts</h2>
            <div class="table-scroll">
              <table id="adminsTable">
                <thead>
                  <tr><th>Username</th><th>Role</th><th>Cluster Access</th></tr>
                </thead>
                <tbody id="adminsTableBody"></tbody>
              </table>
            </div>
          </div>

          <div class="panel-card">
            <h2>Add New Admin</h2>
            <div class="create-error" id="createError"></div>
            <form id="createAdminForm" novalidate>
              <div class="field">
                <label>Username</label>
                <input type="text" id="newUsername" autocomplete="off" />
              </div>
              <div class="field">
                <label>Password</label>
                <input type="password" id="newPassword" autocomplete="new-password" />
                <div class="form-hint">Minimum 8 characters.</div>
              </div>
              <div class="field">
                <label>Role</label>
                <select class="role-select" id="newRole">
                  <option value="Admin">Admin (cluster-restricted)</option>
                  <option value="SuperAdmin">Super Admin (full access)</option>
                </select>
              </div>
              <div class="field" id="clusterCheckWrap">
                <label>Cluster Access</label>
                <div class="cluster-checks" id="clusterChecks">
                  <!-- checkboxes injected by JS -->
                </div>
              </div>
              <button type="submit" class="btn" id="createAdminBtn">
                <div class="spinner"></div>
                <span class="btn-text">Create Account</span>
              </button>
            </form>
          </div>

        </div>
      </div>

    </div>

  </div>

  <div class="toast" id="toast"></div>

  <script>

    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxxon49-M0VjHp5uL5fuwkwtH0LxvTHg0aDDZNVNCUxytnSsYBqhC-in7de-85ckc8h/exec';
    // ───────────────────────────────────────────────────────────────────────────

    const loginScreen     = document.getElementById('loginScreen');
    const dashboardScreen = document.getElementById('dashboardScreen');
    const loginForm       = document.getElementById('loginForm');
    const loginBtn        = document.getElementById('loginBtn');
    const loginError      = document.getElementById('loginError');


    async function callScript(payload) {
      const res = await fetch(SCRIPT_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(payload)
      });
      return res.json();
    }

    function showToast(msg, type = 'error') {
      const t = document.getElementById('toast');
      t.className = 'toast ' + (type === 'success' ? 'success-toast' : 'error-toast');
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 4500);
    }


    function saveSession(token, role, username) {
      sessionStorage.setItem('fc_token', token);
      sessionStorage.setItem('fc_role', role);
      sessionStorage.setItem('fc_username', username);
    }
    function getSession() {
      return {
        token:    sessionStorage.getItem('fc_token'),
        role:     sessionStorage.getItem('fc_role'),
        username: sessionStorage.getItem('fc_username')
      };
    }
    function clearSession() {
      sessionStorage.removeItem('fc_token');
      sessionStorage.removeItem('fc_role');
      sessionStorage.removeItem('fc_username');
    }


    loginForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      loginError.classList.remove('show');

      const username = document.getElementById('username').value.trim();
      const password = document.getElementById('password').value;

      if (!username || !password) {
        loginError.textContent = 'Enter both username and password.';
        loginError.classList.add('show');
        return;
      }

      if (SCRIPT_URL === 'YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL_HERE') {
        loginError.textContent = 'SCRIPT_URL not configured — see setup instructions.';
        loginError.classList.add('show');
        return;
      }

      loginBtn.disabled = true;
      loginBtn.classList.add('loading');

      try {
        const result = await callScript({ action: 'login', username, password });
        if (result.status === 'ok') {
          saveSession(result.token, result.role, result.username);
          enterDashboard();
        } else {
          loginError.textContent = result.message || 'Login failed.';
          loginError.classList.add('show');
        }
      } catch (err) {
        loginError.textContent = 'Could not reach server. Try again.';
        loginError.classList.add('show');
      } finally {
        loginBtn.disabled = false;
        loginBtn.classList.remove('loading');
      }
    });


    document.getElementById('logoutBtn').addEventListener('click', async function() {
      const session = getSession();
      try { await callScript({ action: 'logout', token: session.token }); } catch (e) {}
      clearSession();
      dashboardScreen.style.display = 'none';
      loginScreen.style.display = 'flex';
      loginForm.reset();
    });


    async function enterDashboard() {
      const session = getSession();
      if (!session.token) return;

      loginScreen.style.display = 'none';
      dashboardScreen.style.display = 'block';

      document.getElementById('whoName').textContent = session.username;
      const badge = document.getElementById('roleBadge');
      if (session.role === 'SuperAdmin') {
        badge.textContent = 'Super Admin';
        badge.className = 'badge super';
        document.getElementById('whoScope').textContent = 'Full access — all clusters';
        setupManageAdminsTab();
      } else {
        badge.textContent = 'Admin';
        badge.className = 'badge admin';
        document.getElementById('whoScope').textContent = 'Restricted access — assigned cluster(s) only';
      }

      try {
        const result = await callScript({ action: 'getData', token: session.token });
        if (result.status === 'ok') {
          renderTable(result.headers, result.rows);
        } else {
          showToast(result.message || 'Could not load data.');
          if (result.message && result.message.indexOf('expired') !== -1) {
            clearSession();
            dashboardScreen.style.display = 'none';
            loginScreen.style.display = 'flex';
          }
        }
      } catch (err) {
        showToast('Could not reach server.');
      }
    }

    function renderTable(headers, rows) {
      const thead = document.getElementById('tableHead');
      const tbody = document.getElementById('tableBody');
      const emptyState = document.getElementById('emptyState');
      const table = document.getElementById('dataTable');

      thead.innerHTML = '<tr>' + headers.map(h => `<th>${escapeHtml(h)}</th>`).join('') + '</tr>';

      const clusterColIdx = headers.indexOf('Cluster');
      const clusters = new Set();

      if (rows.length === 0) {
        tbody.innerHTML = '';
        table.style.display = 'none';
        emptyState.style.display = 'block';
      } else {
        table.style.display = 'table';
        emptyState.style.display = 'none';
        tbody.innerHTML = rows.map(row => {
          if (clusterColIdx !== -1) clusters.add(String(row[clusterColIdx]));
          return '<tr>' + row.map((cell, idx) => {
            if (idx === clusterColIdx) {
              return `<td><span class="cluster-chip">Cluster ${escapeHtml(String(cell))}</span></td>`;
            }
            return `<td>${escapeHtml(String(cell))}</td>`;
          }).join('') + '</tr>';
        }).join('');
      }

      document.getElementById('statTotal').textContent = rows.length;
      document.getElementById('statClusters').textContent = clusters.size;
    }

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }


    let manageTabInitialized = false;

    function setupManageAdminsTab() {

      if (!document.getElementById('tabManageAdmins')) {
        const btn = document.createElement('button');
        btn.className = 'tab-btn';
        btn.id = 'tabManageAdmins';
        btn.dataset.view = 'manageAdmins';
        btn.textContent = 'Manage Admins';
        document.getElementById('tabRow').appendChild(btn);
      }

      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.onclick = () => switchTab(btn.dataset.view);
      });

      if (!manageTabInitialized) {
        renderClusterCheckboxes();
        document.getElementById('newRole').addEventListener('change', function() {
          document.getElementById('clusterCheckWrap').style.display =
            this.value === 'SuperAdmin' ? 'none' : 'flex';
        });
        document.getElementById('createAdminForm').addEventListener('submit', handleCreateAdminSubmit);
        manageTabInitialized = true;
      }
    }

    function switchTab(view) {
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.toggle('active', b.dataset.view === view);
      });
      document.getElementById('registrationsView').style.display = view === 'registrations' ? 'block' : 'none';
      document.getElementById('manageAdminsView').style.display = view === 'manageAdmins' ? 'block' : 'none';
      if (view === 'manageAdmins') loadAdminsList();
    }

    function renderClusterCheckboxes() {
      const wrap = document.getElementById('clusterChecks');
      wrap.innerHTML = '';
      for (let c = 1; c <= 6; c++) {
        const label = document.createElement('label');
        label.className = 'cluster-check-item';
        label.innerHTML = `<input type="checkbox" value="${c}" /> Cluster ${c}`;
        wrap.appendChild(label);
      }
    }

    async function loadAdminsList() {
      const session = getSession();
      try {
        const result = await callScript({ action: 'listAdmins', token: session.token });
        const tbody = document.getElementById('adminsTableBody');
        if (result.status === 'ok') {
          tbody.innerHTML = result.admins.map(a => {
            const pillClass = a.role === 'SuperAdmin' ? 'super' : 'admin';
            const clusterText = a.role === 'SuperAdmin' ? 'ALL' : a.clusterAccess;
            return `<tr>
              <td>${escapeHtml(a.username)}</td>
              <td><span class="role-pill ${pillClass}">${escapeHtml(a.role)}</span></td>
              <td>${escapeHtml(String(clusterText))}</td>
            </tr>`;
          }).join('');
        } else {
          showToast(result.message || 'Could not load admin list.');
        }
      } catch (err) {
        showToast('Could not reach server.');
      }
    }

    async function handleCreateAdminSubmit(e) {
      e.preventDefault();
      const errorBox = document.getElementById('createError');
      errorBox.classList.remove('show');

      const newUsername = document.getElementById('newUsername').value.trim();
      const newPassword = document.getElementById('newPassword').value;
      const newRole = document.getElementById('newRole').value;
      const checkedClusters = Array.from(document.querySelectorAll('#clusterChecks input:checked')).map(cb => cb.value);

      if (!newUsername || !newPassword) {
        errorBox.textContent = 'Username and password are required.';
        errorBox.classList.add('show');
        return;
      }
      if (newPassword.length < 8) {
        errorBox.textContent = 'Password must be at least 8 characters.';
        errorBox.classList.add('show');
        return;
      }
      if (newRole === 'Admin' && checkedClusters.length === 0) {
        errorBox.textContent = 'Select at least one cluster for an Admin account.';
        errorBox.classList.add('show');
        return;
      }

      const btn = document.getElementById('createAdminBtn');
      btn.disabled = true;
      btn.classList.add('loading');

      const session = getSession();
      try {
        const result = await callScript({
          action: 'createAdmin',
          token: session.token,
          newUsername: newUsername,
          newPassword: newPassword,
          newRole: newRole,
          newClusterAccess: checkedClusters.join(',')
        });

        if (result.status === 'ok') {
          showToast('Admin account created.', 'success');
          document.getElementById('createAdminForm').reset();
          renderClusterCheckboxes();
          document.getElementById('clusterCheckWrap').style.display = 'flex';
          loadAdminsList();
        } else {
          errorBox.textContent = result.message || 'Could not create account.';
          errorBox.classList.add('show');
        }
      } catch (err) {
        errorBox.textContent = 'Could not reach server.';
        errorBox.classList.add('show');
      } finally {
        btn.disabled = false;
        btn.classList.remove('loading');
      }
    }

    // ── Auto-resume session on page load ────────────────────────────────────
    (function init() {
      const session = getSession();
      if (session.token) {
        enterDashboard();
      }
    })();
  </script>
</body>
</html>
